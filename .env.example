NEXT_PUBLIC_CONVEX_URL=

# Convex environment variables, set in Convex Dashboard:
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=rks.okeciewarszawa
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v22.0

# Optional match sync from Łączy Nas Piłka / PZPN competition API.
# The public frontend exposes competition endpoints, but API calls require
# a Bearer token. Store it only in Convex env vars, never in the browser.
LNP_COMPETITION_API_BASE=https://competition-api-pro.laczynaspilka.pl/api/bus/competition/v1/
LNP_BEARER_TOKEN=
LNP_PLAY_ID=
LNP_TEAM_ID=

# Public fallback for RKS match sync from Futbolowo schedule pages.
# Format: url|team-slug|match-type,comma-separated. match-type: liga, puchar, sparing, turniej.
FUTBOLOWO_SCHEDULE_URLS=https://rksokecie.futbolowo.pl/schedule/3637/27558/4458|seniorzy|puchar
